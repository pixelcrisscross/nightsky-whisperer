@app.get("/sky/visible")
async def sky_visible(limit: int = 25) -> dict[str, Any]:
    telemetry, received_at = await _current_observer_state()
    if not telemetry:
        return {"available": False, "message": "Connect the Android app and wait for telemetry."}
    loc = telemetry.get("location") or {}
    try:
        latitude = float(loc["latitude_deg"])
        longitude = float(loc["longitude_deg"])
        timestamp = float(telemetry.get("ts_unix_ms", 0)) / 1000.0
        if timestamp <= 0:
            timestamp = float(received_at or time.time())
        objects = visible_bright_stars(latitude, longitude, timestamp)
        limit = max(1, min(int(limit), 100))
        return {
            "available": True,
            "timestamp_unix": timestamp,
            "observer": {"latitude_deg": latitude, "longitude_deg": longitude,
                         "location_accuracy_m": loc.get("accuracy_m")},
            "visible_count": len(objects),
            "objects": objects[:limit],
            "note": "Geometric horizon only; no refraction, terrain/horizon mask, twilight, cloud, or glare model.",
        }
    except (KeyError, TypeError, ValueError, OverflowError) as exc:
        return {"available": False, "error": f"Invalid or unavailable observer telemetry: {exc}"}


