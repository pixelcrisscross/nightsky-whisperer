@app.websocket("/ws/phone")
async def phone_websocket(websocket: WebSocket) -> None:
    await websocket.accept()
    async with _state_lock:
        STATE["connected_clients"] += 1
    print(f"[phone] connected from {websocket.client}")
    audio_capture: bytearray | None = None
    audio_capture_started: float | None = None
    pending_transcriptions: list[
        tuple[asyncio.Task[dict[str, Any]], Path, float]
    ] = []
    try:
        await websocket.send_json({
            "type": "hello",
            "protocol_version": 1,
            "service": "nightsky-phone-bridge",
            "message": "Connected. Send telemetry JSON; PCM16 audio uses binary frames.",
        })
        while True:
            packet = await websocket.receive()
            if packet.get("type") == "websocket.disconnect":
                break

            # Deliver finished transcription results from the main WebSocket
            # loop, keeping outbound messages serialized with normal telemetry.
            remaining_transcriptions = []
            for task, source_path, source_duration in pending_transcriptions:
                if not task.done():
                    remaining_transcriptions.append(
                        (task, source_path, source_duration)
                    )
                    continue

                try:
                    outcome = task.result()
                except Exception as exc:
                    outcome = {"ok": False, "error": str(exc)}

                if outcome.get("ok"):
                    transcript = str(outcome.get("text", "")).strip()
                    AUDIO_STATE.update({
                        "last_transcription": transcript,
                        "last_transcription_at": time.time(),
                        "last_transcription_error": None,
                    })
                    await websocket.send_json({
                        "type": "transcription_result",
                        "ok": True,
                        "text": transcript,
                        "audio_duration_seconds": source_duration,
                    })
                    print(f"[speech] transcription: {transcript!r}")

                    response_text = str(outcome.get("response", "")).strip()
                    if response_text:
                        response_ok = bool(outcome.get("response_ok", True))
                        response_error = outcome.get("response_error")
                        AUDIO_STATE.update({
                            "last_assistant_response": response_text,
                            "last_assistant_error": response_error,
                        })
                        await websocket.send_json({
                            "type": "assistant_response",
                            "ok": response_ok,
                            "input_text": transcript,
                            "text": response_text,
                        })
                        print(f"[assistant] response: {response_text!r}")

                        speech_pcm = outcome.get("speech_pcm")
                        if isinstance(speech_pcm, bytes) and speech_pcm:
                            speech_rate = int(
                                outcome.get("speech_sample_rate_hz") or 22050
                            )
                            speech_duration = float(
                                outcome.get("speech_duration_seconds")
                                or len(speech_pcm) / (speech_rate * 2)
                            )

                            AUDIO_STATE.update({
                                "last_speech_error": None,
                                "last_speech_duration_seconds": round(
                                    speech_duration, 3
                                ),
                            })

                            # Android creates an AudioTrack from this sample rate.
                            await websocket.send_json({
                                "type": "audio_playback_start",
                                "sample_rate_hz": speech_rate,
                                "channels": 1,
                                "encoding": "pcm_s16le",
                                "duration_seconds": round(speech_duration, 3),
                                "source": "piper_tts",
                            })

                            for chunk in iter_pcm_chunks(speech_pcm):
                                await websocket.send_bytes(chunk)

                            await websocket.send_json({
                                "type": "audio_playback_end",
                                "duration_seconds": round(speech_duration, 3),
                                "source": "piper_tts",
                            })
                            print(
                                f"[speech] streamed Piper audio: "
                                f"{speech_duration:.2f}s at {speech_rate} Hz"
                            )
                        else:
                            speech_error = str(
                                outcome.get("speech_error")
                                or "Piper returned no audio."
                            )
                            AUDIO_STATE["last_speech_error"] = speech_error
                            print(f"[speech] TTS unavailable: {speech_error}")
                else:
                    error = str(outcome.get("error", "Unknown transcription error"))
                    AUDIO_STATE["last_transcription_error"] = error
                    await websocket.send_json({
                        "type": "transcription_result",
                        "ok": False,
                        "text": "",
                        "error": error,
                        "audio_duration_seconds": source_duration,
                    })
                    print(f"[speech] transcription failed: {error}")

            pending_transcriptions = remaining_transcriptions

            binary_payload = packet.get("bytes")
            if binary_payload is not None:
                if audio_capture is None:
                    await websocket.send_json({
                        "type": "error",
                        "message": "Received binary data without audio_start; send audio_start before PCM frames.",
                    })
                    continue
                if len(audio_capture) + len(binary_payload) > MAX_AUDIO_BYTES:
                    audio_capture = None
                    audio_capture_started = None
                    AUDIO_STATE.update({"capture_active": False, "last_error": "recording_limit_exceeded"})
                    await websocket.send_json({
                        "type": "error",
                        "message": f"Recording exceeds {MAX_AUDIO_SECONDS} seconds; capture discarded.",
                    })
                    continue
                audio_capture.extend(binary_payload)
                continue

            raw = packet.get("text")
            if raw is None:
                continue
            try:
                message = json.loads(raw)
            except json.JSONDecodeError:
                await websocket.send_json({"type": "error", "message": "Invalid JSON"})
                continue
            if not isinstance(message, dict):
                await websocket.send_json({"type": "error", "message": "Message must be a JSON object"})
                continue
            message_type = message.get("type")
            if message_type == "telemetry":
                received_at = time.time()
                async with _state_lock:
                    STATE["latest_telemetry"] = message
                    STATE["latest_received_at"] = received_at
                    STATE["telemetry_count"] += 1
                    TELEMETRY_HISTORY.append((received_at, message))
                    count = STATE["telemetry_count"]
                if count == 1 or count % 25 == 0:
                    loc = message.get("location") or {}
                    ori = message.get("orientation") or {}
                    print(
                        f"[telemetry #{count}] lat={loc.get('latitude_deg')} lon={loc.get('longitude_deg')} "
                        f"heading={ori.get('phone_top_azimuth_deg')} pitch={ori.get('pitch_deg')} "
                        f"roll={ori.get('roll_deg')} declination={ori.get('magnetic_declination_deg')}"
                    )
                if count == 1 or count % 25 == 0:
                    await websocket.send_json({
                        "type": "ack", "telemetry_count": count,
                        "server_time_unix_ms": int(received_at * 1000),
                    })
            elif message_type == "ping":
                await websocket.send_json({"type": "pong", "server_time_unix_ms": int(time.time() * 1000)})
            elif message_type == "audio_start":
                sample_rate = int(message.get("sample_rate_hz", 0))
                channels = int(message.get("channels", 0))
                encoding = str(message.get("encoding", ""))
                if sample_rate != AUDIO_SAMPLE_RATE_HZ or channels != AUDIO_CHANNELS or encoding != "pcm_s16le":
                    await websocket.send_json({
                        "type": "error",
                        "message": f"Audio format must be pcm_s16le, {AUDIO_SAMPLE_RATE_HZ} Hz, mono.",
                    })
                    continue
                if audio_capture is not None:
                    await websocket.send_json({"type": "error", "message": "Audio capture is already active."})
                    continue
                audio_capture = bytearray()
                audio_capture_started = time.time()
                AUDIO_STATE.update({"capture_active": True, "last_error": None})
                await websocket.send_json({
                    "type": "audio_started", "sample_rate_hz": AUDIO_SAMPLE_RATE_HZ,
                    "channels": AUDIO_CHANNELS, "max_seconds": MAX_AUDIO_SECONDS,
                })
            elif message_type == "audio_stop":
                if audio_capture is None:
                    await websocket.send_json({"type": "error", "message": "No audio capture is active."})
                    continue
                pcm = normalize_pcm16(bytes(audio_capture))
                started = audio_capture_started or time.time()
                audio_capture = None
                audio_capture_started = None
                AUDIO_STATE["capture_active"] = False
                if not pcm:
                    AUDIO_STATE["last_error"] = "empty_recording"
                    await websocket.send_json({"type": "error", "message": "No microphone audio was received."})
                    continue
                try:
                    saved_path = write_pcm_wav(pcm, AUDIO_LATEST_WAV, AUDIO_SAMPLE_RATE_HZ)
                except Exception as exc:
                    AUDIO_STATE["last_error"] = f"save_failed: {exc}"
                    await websocket.send_json({"type": "error", "message": f"Could not save audio: {exc}"})
                    continue
                duration = len(pcm) / (AUDIO_SAMPLE_RATE_HZ * AUDIO_CHANNELS * 2)
                AUDIO_STATE.update({
                    "last_recording_path": str(saved_path),
                    "last_recording_bytes": len(pcm),
                    "last_recording_seconds": round(duration, 3),
                    "last_error": None,
                })
                await websocket.send_json({
                    "type": "audio_saved", "path": str(saved_path),
                    "pcm_bytes": len(pcm), "duration_seconds": round(duration, 3),
                })
                # Optional microphone loopback for diagnostics. Disabled during
                # normal conversation so the assistant does not replay the user.
                echo_mic = os.getenv(
                    "NIGHTSKY_ECHO_MIC", "0"
                ).strip().lower() in {"1", "true", "yes", "on"}

                if echo_mic:
                    await websocket.send_json({
                        "type": "audio_playback_start",
                        "sample_rate_hz": AUDIO_SAMPLE_RATE_HZ,
                        "channels": AUDIO_CHANNELS,
                        "encoding": "pcm_s16le",
                        "duration_seconds": round(duration, 3),
                        "source": "mic_loopback_test",
                    })
                    for audio_chunk in iter_pcm_chunks(pcm):
                        await websocket.send_bytes(audio_chunk)
                    await websocket.send_json({
                        "type": "audio_playback_end",
                        "duration_seconds": round(duration, 3),
                    })
                else:
                    print("[audio] microphone echo disabled; proceeding to assistant")

                # Run Whisper concurrently with the ongoing phone telemetry.
                pending_transcriptions.append((
                    asyncio.create_task(_transcribe_wav_async(saved_path)),
                    saved_path,
                    round(duration, 3),
                ))
                print(f"[speech] queued transcription for {saved_path}")
            else:
                await websocket.send_json({
                    "type": "ack", "message_type": message_type,
                    "message": "Message received; this message type is not implemented yet.",
                })
    except WebSocketDisconnect:
        print("[phone] disconnected")
    except Exception as exc:
        print(f"[phone] websocket error: {exc!r}")
        try:
            await websocket.close(code=1011, reason="Internal bridge error")
        except Exception:
            pass
    finally:
        AUDIO_STATE["capture_active"] = False
        async with _state_lock:
            STATE["connected_clients"] = max(0, STATE["connected_clients"] - 1)


