@app.post("/target/select")
async def target_select(request: TargetSelectRequest) -> dict[str, Any]:
    """Select a bright-star target by ID or case-insensitive display name."""
    requested = request.target.strip().casefold()
    if not requested:
        raise HTTPException(status_code=422, detail="target must not be empty")
    target = next((obj for obj in BRIGHT_STARS
                   if obj["id"].casefold() == requested or obj["name"].casefold() == requested), None)
    if target is None:
        matches = [obj["name"] for obj in BRIGHT_STARS if requested in obj["name"].casefold()]
        detail = "Unknown target. This version supports the curated bright-star catalog only."
        if matches:
            detail += " Possible matches: " + ", ".join(matches)
        raise HTTPException(status_code=404, detail=detail)
    async with _state_lock:
        STATE["selected_target_id"] = target["id"]
        STATE["target_selected_at_unix"] = time.time()
    return {
        "available": True,
        "selected": True,
        "target": target,
        "message": f"Target selected: {target['name']}. Query /target/guidance for pointing directions.",
    }


