@app.post("/calibration/capture")
async def calibration_capture(request: CardinalCaptureRequest) -> dict[str, Any]:
    direction = request.direction.strip().lower()
    if direction not in {"north", "east", "south", "west"}:
        raise HTTPException(status_code=422, detail="direction must be north, east, south, or west")

    now = time.time()
    async with _state_lock:
        recent = [(received_at, message) for received_at, message in TELEMETRY_HISTORY
                  if now - received_at <= 2.5]
    readings: list[tuple[float, float]] = []
    for _, message in recent:
        orientation = message.get("orientation") or {}
        result = compute_pointing(
            orientation.get("rotation_vector"),
            magnetic_declination_deg=orientation.get("magnetic_declination_deg"),
        )
        if not result.get("available"):
            continue
        axis = result.get("top_edge") or {}
        azimuth = axis.get("true_azimuth_deg")
        elevation = axis.get("elevation_deg")
        if azimuth is None or elevation is None:
            continue
        # For a horizontal cardinal capture, reject tilted samples rather than
        # averaging a compass bearing that is undefined near vertical.
        if abs(float(elevation)) <= 10.0:
            readings.append((float(azimuth), float(elevation)))

    if len(readings) < 5:
        raise HTTPException(
            status_code=422,
            detail=("Not enough recent horizontal samples. Keep the phone connected, hold its top edge "
                    "horizontal toward the reference direction for 2–3 seconds, then capture again."),
        )
    try:
        mean_azimuth, _ = circular_mean_deg([r[0] for r in readings])
    except ValueError as exc:
        raise HTTPException(status_code=422, detail=f"Unstable heading samples: {exc}") from exc
    spread = max(abs(wrap180(r[0] - mean_azimuth)) for r in readings)
    mean_elevation = sum(r[1] for r in readings) / len(readings)
    if spread > 8.0:
        raise HTTPException(
            status_code=422,
            detail=f"Heading is unstable (spread {spread:.1f}°). Hold the assembled phone still and retry.",
        )
    if abs(mean_elevation) > 10.0:
        raise HTTPException(status_code=422, detail="The phone's top edge must be horizontal within ±10°.")

    try:
        result = CALIBRATION.add_capture(
            direction=direction,
            measured_true_azimuth_deg=mean_azimuth,
            elevation_deg=mean_elevation,
            sample_count=len(readings),
            spread_deg=spread,
        )
    except ValueError as exc:
        raise HTTPException(status_code=422, detail=str(exc)) from exc
    result["last_capture"] = result["captures"].get(direction)
    return result


