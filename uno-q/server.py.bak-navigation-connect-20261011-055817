    )
    if not raw_pointing.get("available"):
        return {"available": False, "error": raw_pointing.get("error", "Pointing is unavailable")}
    try:
        latitude = float(location["latitude_deg"])
        longitude = float(location["longitude_deg"])
        axis = raw_pointing["top_edge"]
        raw_azimuth = axis.get("true_azimuth_deg")
        if raw_azimuth is None:
            raw_azimuth = axis["magnetic_or_sensor_azimuth_deg"]
        raw_azimuth = float(raw_azimuth)
        altitude = float(axis["elevation_deg"])
        heading_offset = CALIBRATION.valid_offset()
        azimuth = (raw_azimuth + heading_offset) % 360.0 if heading_offset is not None else raw_azimuth
        timestamp = float(telemetry.get("ts_unix_ms", 0)) / 1000.0
        if timestamp <= 0:
            timestamp = float(received_at or time.time())
        ranked = nearest_bright_stars(latitude, longitude, timestamp, float(azimuth), altitude, limit=limit)
        ranked.update({
            "calibration_required": heading_offset is None,
            "heading_calibration": CALIBRATION.status(),
            "raw_pointing": {
                "azimuth_deg": round(raw_azimuth % 360.0, 3),
                "altitude_deg": round(altitude, 3),
            },
            "pointing": {
                "azimuth_deg": round(azimuth % 360.0, 3),
                "altitude_deg": round(altitude, 3),
                "heading_calibration_applied": heading_offset is not None,
            },
            "pointing_axis": "top_edge",
            "pointing_source": "calibrated_true_azimuth" if heading_offset is not None else "uncalibrated_true_azimuth",
            "timestamp_unix": timestamp,
            "observer": {"latitude_deg": latitude, "longitude_deg": longitude,
                         "location_accuracy_m": location.get("accuracy_m")},
        })
        if heading_offset is None:
            ranked["warning"] = (
                "Diagnostic only: compass/cardinal calibration has not been validated. Do not use nearest-star "
                "results for target acquisition yet. This endpoint ranks bright stars only, not constellations or planets."
            )
        else:
            ranked["warning"] = (
                "Heading offset has passed the cardinal consistency check. Still verify outdoors with the assembled "
                "device; results are bright-star candidates, not constellation recognition or planetary positions."
            )
        return ranked
    except (KeyError, TypeError, ValueError, OverflowError) as exc:
        return {"available": False, "error": f"Cannot calculate nearest targets: {exc}"}


