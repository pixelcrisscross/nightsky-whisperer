def _run_whisper_cli(audio_path: Path) -> dict[str, Any]:
    """Transcribe a saved WAV with the existing local Whisper installation."""
    if not WHISPER_BIN.is_file():
        return {"ok": False, "error": f"Whisper executable not found: {WHISPER_BIN}"}
    if not WHISPER_MODEL.is_file():
        return {"ok": False, "error": f"Whisper model not found: {WHISPER_MODEL}"}

    try:
        result = subprocess.run(
            [
                str(WHISPER_BIN),
                "-m", str(WHISPER_MODEL),
                "-f", str(audio_path),
                "--no-timestamps",
                "--no-prints",
                "-t", "4",
                "-l", "en",
            ],
            capture_output=True,
            text=True,
            timeout=60,
            check=False,
        )
    except subprocess.TimeoutExpired:
        return {"ok": False, "error": "Whisper transcription timed out after 60 seconds."}
    except Exception as exc:
        return {"ok": False, "error": f"Could not run Whisper: {exc}"}

    if result.returncode != 0:
        detail = (result.stderr or result.stdout).strip()[-1500:]
        return {
            "ok": False,
            "error": f"Whisper exited with code {result.returncode}: {detail}",
        }

    transcript = result.stdout.strip().replace("[BLANK_AUDIO]", "").strip()
    return {"ok": True, "text": transcript}


def _run_gemma_cli(user_text: str) -> dict[str, Any]:
    """Generate a concise response using the already-loaded local Gemma server."""
    if not GEMMA_MODEL.is_file():
        return {"ok": False, "error": f"Gemma model not found: {GEMMA_MODEL}"}

    endpoint = os.getenv(
        "NIGHTSKY_GEMMA_URL",
        "http://127.0.0.1:8083/v1/chat/completions",
    )
    payload = {
        "model": GEMMA_MODEL.name,
        "messages": [
            {
                "role": "system",
                "content": (
                    "You are NightSky Whisperer, a friendly offline astronomy "
                    "companion. Answer in one to three concise sentences suitable "
                    "for speech. Be clear and factual. Do not invent live sky "
                    "conditions or claim to know the user's pointing or location "
                    "unless that information is supplied. Do not claim an action "
                    "was performed unless it actually was."
                ),
            },
            {"role": "user", "content": user_text.strip()},
        ],
        "max_tokens": 100,
        "temperature": 0.2,
        "stream": False,
    }

    request = urllib.request.Request(
        endpoint,
        data=json.dumps(payload).encode("utf-8"),
        headers={"Content-Type": "application/json"},
        method="POST",
    )

    try:
        with urllib.request.urlopen(request, timeout=90) as response:
            data = json.loads(response.read().decode("utf-8"))
    except urllib.error.HTTPError as exc:
        detail = exc.read().decode("utf-8", errors="replace")[-1000:]
        return {"ok": False, "error": f"Gemma HTTP {exc.code}: {detail}"}
    except (urllib.error.URLError, TimeoutError) as exc:
        return {
            "ok": False,
            "error": f"Persistent Gemma server unavailable at {endpoint}: {exc}",
        }
    except Exception as exc:
        return {"ok": False, "error": f"Gemma request failed: {exc}"}

    try:
        answer = data["choices"][0]["message"]["content"].strip()
    except (KeyError, IndexError, TypeError, AttributeError) as exc:
        return {
            "ok": False,
            "error": f"Unexpected Gemma response format: {exc}; data={str(data)[:800]}",
        }

    if not answer:
        return {"ok": False, "error": "Gemma returned an empty response."}

    return {"ok": True, "text": answer}

def _run_piper_cli(text: str) -> dict[str, Any]:
    """Synthesize speech with the cached Alba voice."""
    if not text.strip():
        return {"ok": False, "error": "No text supplied to Piper."}

    if not PIPER_MODEL.is_file():
        return {"ok": False, "error": f"Piper voice model not found: {PIPER_MODEL}"}

    output_path = None
    try:
        voice = _get_piper_voice()

        fd, output_path = tempfile.mkstemp(
            prefix="nightsky-tts-", suffix=".wav"
        )
        os.close(fd)

        # Serialize inference against the shared voice object.
        with _PIPER_SYNTH_LOCK:
            with wave.open(output_path, "wb") as wav_file:
                voice.synthesize_wav(text.strip(), wav_file)

        with wave.open(output_path, "rb") as wav:
            channels = wav.getnchannels()
            width = wav.getsampwidth()
            rate = wav.getframerate()
            pcm = wav.readframes(wav.getnframes())

        if channels != 1 or width != 2 or rate <= 0 or not pcm:
            return {"ok": False, "error": "Piper returned invalid audio format or empty audio."}

        return {
            "ok": True,
            "pcm": pcm,
            "sample_rate_hz": rate,
            "duration_seconds": len(pcm) / (rate * 2),
        }

    except Exception as exc:
        return {"ok": False, "error": f"Piper synthesis failed: {exc}"}
    finally:
        if output_path:
            try:
                os.unlink(output_path)
            except OSError:
                pass

def _normalize_astronomy_transcript(text: str) -> str:
    """Correct a small set of predictable speech-recognition errors."""
    result = re.sub(
        r"\b(?:beetle[\s-]*juice|betel[\s-]*juice|better[\s-]*juice|betelgeuse)\b",
        "Betelgeuse",
        text,
        flags=re.IGNORECASE,
    )

    # Correct common wake-phrase errors only at the start of a greeting.
    result = re.sub(
        r"^\s*(hi|hey|hello)[, ]+(?:nice guy|night sky|night-sky)\b",
        r"\1 NightSky",
        result,
        count=1,
        flags=re.IGNORECASE,
    )
    return result.strip()


def _known_astronomy_answer(text: str) -> str | None:
    """Answer a narrowly recognized basic star question deterministically."""
    lower = text.lower()

    asks_for_explanation = re.search(
        r"\b(?:what is|what's|tell me about|describe|explain)\b",
        lower,
    )
    asks_to_find = re.search(
        r"\b(?:find|locate|point(?: me)? to|show me|navigate to)\b",
        lower,
    )

    if "betelgeuse" in lower and asks_for_explanation and not asks_to_find:
        return (
            "Betelgeuse is a red supergiant star in Orion, "
            "known for its reddish colour near the hunter's shoulder."
        )

    return None


def _parse_target_command(text: str) -> dict[str, Any] | None:
    """Recognize explicit target requests against the curated star catalogue."""
    command = re.search(
        r"\b(?:find|locate|show\s+me|look\s+for|search\s+for|"
        r"navigate\s+to|point(?:\s+me)?\s+(?:to|at))\b",
        text,
        flags=re.IGNORECASE,
    )
    if not command:
        return None

    requested = text[command.end():].strip(" \t.,!?;:")
    requested = re.sub(
        r"\b(?:please|now|tonight|right\s+now|for\s+me)\b",
        "",
        requested,
        flags=re.IGNORECASE,
    ).strip(" \t.,!?;:")

    if not requested:
        return {"type": "find_target", "target": ""}

    # Prefer exact catalogue names and longer names first.
    for star in sorted(
        BRIGHT_STARS,
        key=lambda item: len(str(item["name"])),
        reverse=True,
    ):
        name = str(star["name"])
        if re.search(
            r"(?<!\w)" + re.escape(name) + r"(?!\w)",
            requested,
            flags=re.IGNORECASE,
        ):
            return {"type": "find_target", "target": name}

    return {"type": "find_target", "target": requested[:80]}


def _run_voice_pipeline(audio_path: Path) -> dict[str, Any]:
    """Transcribe, correct known astronomy terms, answer, then synthesize."""
    pipeline_started = time.perf_counter()

    stage_started = time.perf_counter()
    transcription = _run_whisper_cli(audio_path)
    print(f"[timing] whisper={time.perf_counter() - stage_started:.2f}s")

    if not transcription.get("ok"):
        print(f"[timing] pipeline_total={time.perf_counter() - pipeline_started:.2f}s")
        return transcription

    raw_text = str(transcription.get("text", "")).strip()
    recognized_text = _normalize_astronomy_transcript(raw_text)

    if recognized_text != raw_text:
        print(f"[speech] normalized transcript: {recognized_text!r}")

    if not recognized_text:
        response_text = "Sorry, I couldn't make out what you said. Please try again."
        response_ok = True
        response_error = None
    else:
        # Prefer a trusted local response for this known basic astronomy query.
        response_text = _known_astronomy_answer(recognized_text)

        if response_text is not None:
            response_ok = True
            response_error = None
            print("[assistant] using deterministic astronomy answer")
        else:
            stage_started = time.perf_counter()
            generated = _run_gemma_cli(recognized_text)
            print(f"[timing] gemma={time.perf_counter() - stage_started:.2f}s")

            if generated.get("ok"):
                response_text = str(generated.get("text", "")).strip()
                response_ok = bool(response_text)
                response_error = None
                if not response_text:
                    response_text = "Sorry, I couldn't generate a response."
            else:
                response_text = (
                    "I recognized your words, but couldn't generate a reply "
                    "with my local language model."
                )
                response_ok = False
                response_error = str(
                    generated.get("error", "Unknown Gemma error")
                )

    stage_started = time.perf_counter()
    speech = _run_piper_cli(response_text)
    print(f"[timing] piper={time.perf_counter() - stage_started:.2f}s")

    outcome = {
        "ok": True,
        "raw_text": raw_text,
        "text": recognized_text,
        "response": response_text,
        "response_ok": response_ok,
        "response_error": response_error,
        "speech_ok": bool(speech.get("ok")),
        "speech_sample_rate_hz": speech.get("sample_rate_hz"),
        "speech_duration_seconds": speech.get("duration_seconds"),
        "speech_error": speech.get("error"),
    }

    if speech.get("ok"):
        outcome["speech_pcm"] = speech["pcm"]

    print(f"[speech] transcription: {recognized_text!r}")
    print(f"[assistant] response: {response_text!r}")
    print(f"[timing] pipeline_total={time.perf_counter() - pipeline_started:.2f}s")

    return outcome


async def _transcribe_wav_async(audio_path: Path) -> dict[str, Any]:
    """Keep speech and language-model inference off the WebSocket event loop."""
    return await asyncio.to_thread(_run_voice_pipeline, audio_path)



def _apply_heading_calibration(pointing: dict[str, Any], offset: float | None) -> dict[str, Any]:
    """Annotate pointing response and correct the selected top-edge azimuth only."""
    result = dict(pointing)
    if not result.get("available"):
        return result
    top = dict(result.get("top_edge") or {})
    raw = top.get("true_azimuth_deg")
    top["raw_true_azimuth_deg"] = raw
    top["heading_calibration_applied"] = offset is not None and raw is not None
    if raw is not None and offset is not None:
        top["true_azimuth_deg"] = round((float(raw) + offset) % 360.0, 3)
    result["top_edge"] = top
    result["calibration_required"] = offset is None
    return result


