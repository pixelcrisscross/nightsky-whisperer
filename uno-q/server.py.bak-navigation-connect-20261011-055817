    result.update({
        "received_at_unix": received_at,
        "location": {
            "latitude_deg": location.get("latitude_deg"),
            "longitude_deg": location.get("longitude_deg"),
            "accuracy_m": location.get("accuracy_m"),
        },
        "heading_calibration": CALIBRATION.status(),
        "north_reference_note": (
            "true_azimuth_deg includes Android's magnetic-declination estimate; after validation, "
            "the calibrated constant heading offset is applied. Check magnetic interference with the assembled device."
        ),
    })
    if result.get("available"):
        result["calibration_note"] = (
            "Heading calibrated. Confirm outdoors with the assembled device before relying on star acquisition."
            if not result.get("calibration_required") else
            "Calibration required: capture at least three independently verified cardinal directions; four is recommended."
        )
    return result


