@app.get("/target/guidance")
async def target_guidance(acquisition_radius_deg: float = 2.0) -> dict[str, Any]:
    """Return calibrated coarse steering guidance for the selected bright star.

    Direction labels use local sky azimuth/elevation deltas, not yet the physical
    LED matrix's display coordinate frame. Keep that distinction until an LED
    orientation/mounting convention is verified on the real assembly.
    """
    if not 0.5 <= acquisition_radius_deg <= 5.0:
        raise HTTPException(status_code=422, detail="acquisition_radius_deg must be between 0.5 and 5.0")
    telemetry, received_at = await _current_observer_state()
    if not telemetry:
        return {"available": False, "error": "no_phone_telemetry", "message": "Connect the Android app first."}

    async with _state_lock:
        target_id = STATE["selected_target_id"]
    if not target_id:
        return {"available": False, "error": "no_target_selected", "message": "POST /target/select first."}

    age = time.time() - float(received_at or 0.0)
    if received_at is None or age > 3.0:
        return {"available": False, "error": "telemetry_stale", "telemetry_age_seconds": round(age, 2),
                "message": "Phone telemetry is stale. Reconnect the phone bridge before guiding."}

    heading_offset = CALIBRATION.valid_offset()
    if heading_offset is None:
        return {"available": False, "error": "calibration_required", "heading_calibration": CALIBRATION.status(),
                "message": "Capture and validate at least three independent cardinal directions before target guidance."}

    target = next((obj for obj in BRIGHT_STARS if obj["id"] == target_id), None)
    if target is None:
        return {"available": False, "error": "selected_target_missing"}

    orientation = telemetry.get("orientation") or {}
    location = telemetry.get("location") or {}
    pointing = compute_pointing(
        orientation.get("rotation_vector"),
        magnetic_declination_deg=orientation.get("magnetic_declination_deg"),
    )
    if not pointing.get("available"):
        return {"available": False, "error": pointing.get("error", "Pointing unavailable")}

    try:
        latitude = float(location["latitude_deg"])
        longitude = float(location["longitude_deg"])
        axis = pointing["top_edge"]
        raw_azimuth = axis.get("true_azimuth_deg")
        if raw_azimuth is None:
            return {"available": False, "error": "true_north_unavailable",
                    "message": "Android magnetic declination is unavailable; do not guide using an unverified north reference."}
        current_az = (float(raw_azimuth) + heading_offset) % 360.0
        current_alt = float(axis["elevation_deg"])
        timestamp = float(telemetry.get("ts_unix_ms", 0)) / 1000.0
        if timestamp <= 0:
            timestamp = float(received_at)
        target_horizontal = radec_to_altaz(target["ra_deg"], target["dec_deg"], latitude, longitude, timestamp)
        result = calculate_guidance(
            current_azimuth_deg=current_az,
            current_altitude_deg=current_alt,
            target_azimuth_deg=target_horizontal["azimuth_deg"],
            target_altitude_deg=target_horizontal["altitude_deg"],
            acquisition_radius_deg=acquisition_radius_deg,
        )
        result.update({
            "available": True,
            "target": {**target, **target_horizontal},
            "current_pointing": {"azimuth_deg": round(current_az, 3), "altitude_deg": round(current_alt, 3)},
            "heading_calibration": {"applied": True, "offset_deg": round(heading_offset, 3),
                                    "max_residual_deg": CALIBRATION.status().get("max_residual_deg")},
            "observer": {"latitude_deg": latitude, "longitude_deg": longitude,
                         "location_accuracy_m": location.get("accuracy_m")},
            "timestamp_unix": timestamp,
            "telemetry_age_seconds": round(age, 3),
            "guidance_frame": "coarse dominant-axis azimuth/elevation hint; matrix symbols are implemented, but physical phone+board movement mapping still needs validation",
            "safety_note": "Geometric star direction only. This does not confirm that a star is visually visible through clouds, daylight, glare, or obstructions.",
        })
        if target_horizontal["altitude_deg"] < 0.0:
            result["direction"] = "target_below_horizon"
            result["arrow"] = "—"
            result["acquired"] = False
            result["message"] = "This star is geometrically below the horizon at the current location/time."
        return result
    except (KeyError, TypeError, ValueError, OverflowError) as exc:
        return {"available": False, "error": f"Cannot calculate target guidance: {exc}"}


async def _send_matrix_direction(direction: str) -> dict[str, Any]:
    normalized = validate_direction(direction)
    try:
        result = await asyncio.to_thread(MATRIX_RPC.call, "show_direction", normalized)
        async with MATRIX_STATE_LOCK:
            MATRIX_STATE["last_command"] = normalized
            MATRIX_STATE["last_command_at_unix"] = time.time()
            MATRIX_STATE["last_result"] = result
            MATRIX_STATE["last_error"] = None
            MATRIX_STATE["commands_sent"] += 1
        return {"available": True, "sent": True, "direction": normalized, "router_result": result}
    except Exception as exc:
        error = f"{type(exc).__name__}: {exc}"
        async with MATRIX_STATE_LOCK:
            MATRIX_STATE["last_error"] = error
        return {
            "available": False,
            "sent": False,
            "direction": normalized,
            "error": error,
            "hint": "Confirm the NightSkyMatrixBridge App Lab sketch is running and has registered show_direction; check /var/run/arduino-router.sock.",
        }


